APP_NAME=MONSTOPIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
MONSTOPIA_BUSINESS_TIMEZONE=Asia/Bangkok
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monstopia
DB_USERNAME=monstopia_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
PROJECT_FILE_MAX_KB=10240
PROJECT_FILE_DISK=local
BACKUP_RETENTION_DAYS=14
BACKUP_EXTERNAL_DIRECTORY=
MONSTOPIA_RESTORE_HOST=127.0.0.1
MONSTOPIA_RESTORE_PORT=3307
MONSTOPIA_RESTORE_USERNAME=
MONSTOPIA_RESTORE_PASSWORD=
MYSQLDUMP_BINARY=mysqldump

# Private object storage for Production (set both disk values to s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_TIMEOUT=20
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@monstopia.co.th
MAIL_FROM_NAME="MONSTOPIA"

# LINE Messaging API (LINE Notify was discontinued on 2025-03-31)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
